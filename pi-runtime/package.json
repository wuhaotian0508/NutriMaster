{
  "name": "nutrimaster-pi-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi runtime boundary for NutriMaster",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
