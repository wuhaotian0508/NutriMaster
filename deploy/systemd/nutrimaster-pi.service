[Unit]
Description=NutriMaster Pi localhost sidecar
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
Slice=nutrimaster.slice
User=root
WorkingDirectory=/root/code/nutrimaster-current
ExecStart=/root/code/nutrimaster-current/start-pi-production.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
MemoryAccounting=true
MemoryHigh=512M
MemoryMax=768M
MemoryLimit=768M
MemorySwapMax=0
# Pi is restartable and owns no indexes, so it remains more disposable than
# the unified request service but less disposable than an offline build.
OOMScoreAdjust=250
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
