[Unit]
Description=NutriMaster Bohrium compatibility TCP proxy
Requires=nutrimaster-bohrium-proxy.socket
After=nutrimaster-unified.service
PartOf=nutrimaster-unified.service

[Service]
Type=simple
ExecStart=/lib/systemd/systemd-socket-proxyd 127.0.0.1:5080
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
MemoryAccounting=true
MemoryLimit=32M
TasksMax=32
