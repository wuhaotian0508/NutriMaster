[Unit]
Description=Recover an interrupted NutriMaster flat-index bootstrap
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=oneshot
Slice=nutrimaster.slice
User=root
WorkingDirectory=/root/code/nutrimaster-current
ExecStart=/root/code/nutrimaster-current/start-index-builder-production.sh recover-bootstrap
TimeoutStartSec=infinity
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=2560M
MemoryLimit=2560M
MemorySwapMax=0
OOMScoreAdjust=500
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=true

# Deliberately no [Install] section: recovery is explicit and bounded.
