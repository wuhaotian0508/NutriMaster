[Unit]
Description=One-time NutriMaster flat-index bootstrap
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/root/code/nutrimaster-current/data/index/CURRENT
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=oneshot
Slice=nutrimaster.slice
User=root
WorkingDirectory=/root/code/nutrimaster-current
Environment=NUTRIMASTER_LEGACY_INDEX_SOURCE=/root/Projects/NutriMaster/data/index
ExecStart=/root/code/nutrimaster-current/start-index-builder-production.sh bootstrap-legacy
TimeoutStartSec=infinity
TimeoutStopSec=30
KillSignal=SIGTERM
KillMode=control-group
MemoryAccounting=true
MemoryHigh=2G
MemoryMax=2560M
MemoryLimit=2560M
MemorySwapMax=0
OOMScoreAdjust=500
TasksMax=128
LimitNOFILE=65536
NoNewPrivileges=true

# Deliberately no [Install] section: this migration is manual and one-time.
# If it is interrupted, run start-index-builder-production.sh recover-bootstrap
# under the same memory limit before retrying.
