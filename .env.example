# ═══════════════════════════════════════════════════════════
# NutriMaster Pipeline - 环境变量配置模板
# ═══════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# .env 文件已在 .gitignore 中，不会被上传到 GitHub
# ═══════════════════════════════════════════════════════════

# LLM API
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://43.159.131.233:3001/v1
MAIN_MODEL=deepseek-v4-flash
# Experiment extraction can use a separately available model; defaults to MAIN_MODEL.
# EXPERIMENT_MODEL=gemini-2.5-flash
EXTRACTOR_MODEL=gpt-5.5

# Pi agent runtime (start separately from pi-runtime/)
# Requires Node >=22.19; it intentionally only binds to localhost by default.
NUTRIMASTER_PI_RUNTIME_URL=http://127.0.0.1:8787
NUTRIMASTER_PI_HOST=127.0.0.1
NUTRIMASTER_PI_PORT=8787
# Defaults to MAIN_MODEL when omitted.
# NUTRIMASTER_PI_MODEL=deepseek-v4-flash

# ═══════════════════════════════════════════════════════════
# Supabase（Web 标注平台数据导入用）
# ═══════════════════════════════════════════════════════════
# 在 Supabase Dashboard → Settings → API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ═══════════════════════════════════════════════════════════
# Vercel 前端环境变量（需要在 Vercel Dashboard 里手动添加）
# ═══════════════════════════════════════════════════════════
# 前端只需要这两个，不需要 API Key 和 SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ═══════════════════════════════════════════════════════════
# Agent 交互数据采集（内部应用默认采集）
# ═══════════════════════════════════════════════════════════
NUTRIMASTER_INTERACTION_CAPTURE_ENABLED=true
NUTRIMASTER_INTERACTION_CAPTURE_REQUIRE_CONSENT=false
NUTRIMASTER_INTERACTION_PRIVACY_LEVEL=standard
# 默认写入 data/interactions，可替换为挂载盘路径
# NUTRIMASTER_INTERACTION_CAPTURE_DIR=/var/lib/nutrimaster/interactions
# 默认不保存个人库工具返回全文
NUTRIMASTER_INTERACTION_INCLUDE_PERSONAL_CONTENT=false

# Jina requests use the project Clash proxy on demand; keep shell/global proxy off.
NUTRIMASTER_WEB_BUILD_INDEX=0
NUTRIMASTER_WEB_BUILD_GRAPH=0
NUTRIMASTER_ALLOW_ONLINE_REINDEX=0
# Dedicated systemd builder refuses to start unless free disk covers a full
# generation, two dense work copies, a corpus snapshot, and this safety margin.
NUTRIMASTER_INDEX_BUILDER_DISK_SAFETY_BYTES=1073741824
NUTRIMASTER_INDEX_BUILDER_AUTO_ACTIVATE=true
NUTRIMASTER_INDEX_ACTIVATION_TIMEOUT_SECONDS=120
NUTRIMASTER_ADMIN_JSON_MAX_BYTES=16777216
# Extraction-admin ZIP uploads are streamed and recursively bounded.
NUTRIMASTER_ADMIN_ZIP_MAX_BYTES=33554432
NUTRIMASTER_ADMIN_ZIP_MAX_EXTRACTED_BYTES=268435456
NUTRIMASTER_ADMIN_ZIP_MAX_ENTRY_BYTES=33554432
NUTRIMASTER_ADMIN_ZIP_MAX_ENTRIES=2000
NUTRIMASTER_ADMIN_ZIP_MAX_DEPTH=4
NUTRIMASTER_RAG_MAX_CONCURRENT_SEARCHES=1
NUTRIMASTER_ENABLE_FIELD_KEYWORD=true
NUTRIMASTER_REQUIRE_INDEX_GENERATION=true
NUTRIMASTER_REQUIRE_GRAPH_INDEX=true
NUTRIMASTER_PI_TOOL_TIMEOUT_SECONDS=120
NUTRIMASTER_JINA_QUERY_TIMEOUT_SECONDS=15
NUTRIMASTER_JINA_QUERY_MAX_ATTEMPTS=2
NUTRIMASTER_JINA_PROXY_ENABLED=false
NUTRIMASTER_JINA_PROXY_URL=http://127.0.0.1:7890
NUTRIMASTER_CLASH_START_SCRIPT=/data/haotianwu/start-clash.sh
NUTRIMASTER_CLASH_STOP_SCRIPT=/data/haotianwu/stop-clash.sh
NUTRIMASTER_JINA_PROXY_IDLE_STOP_SECONDS=300

# Unified production Web: one FastAPI worker owns legacy + Pi routes.
WEB_HOST=127.0.0.1
WEB_PORT=5000
NUTRIMASTER_UNIFIED_WEB_PORT=5000
NUTRIMASTER_WEB_LIMIT_CONCURRENCY=32
NUTRIMASTER_PIPELINE_DEFAULT_WORKERS=1
NUTRIMASTER_PIPELINE_MAX_WORKERS=1
NUTRIMASTER_EXTRACTION_MAX_MARKDOWN_BYTES=16777216
NUTRIMASTER_PERSONAL_LIBRARY_CACHE_SIZE=16
NUTRIMASTER_PERSONAL_LIBRARY_CACHE_TTL_SECONDS=900
# Full sparse retrieval stays enabled, but artifacts must be built offline.
NUTRIMASTER_DISABLE_BM25=false
NUTRIMASTER_REQUIRE_SPARSE_INDEXES=true
NUTRIMASTER_SPARSE_INDEX_BUILD_ON_MISS=false
NUTRIMASTER_RAG_MMAP_EMBEDDINGS=true
NUTRIMASTER_PI_MAX_ACTIVE_RUNS=8
NUTRIMASTER_PI_TURN_TIMEOUT_SECONDS=300
UV_LINK_MODE=copy
