# ═══════════════════════════════════════════════════════════
# NutriMaster Pipeline - 环境变量配置模板
# ═══════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# .env 文件已在 .gitignore 中，不会被上传到 GitHub
# ═══════════════════════════════════════════════════════════

# LLM API
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.agtcloud.cn/v1
MAIN_MODEL=the-main-model
EXTRACTOR_MODEL=the-extraction-model

#jina API
JINA_API_KEY=your-jina-api

# RAG路径
RAG_DATA_DIR=/home/liubj/Projects/NutriMaster/data/corpus
RAG_INDEX_DIR=/home/liubj/Projects/NutriMaster/data/index
RAG_PERSONAL_LIB_DIR=/home/liubj/Projects/NutriMaster/data/personal_lib
NUTRIMASTER_WEB_BUILD_INDEX=0
NUTRIMASTER_DISABLE_BM25=true
NUTRIMASTER_RAG_MMAP_EMBEDDINGS=true


# Supabase（Web 标注平台数据导入用）
# 在 Supabase Dashboard → Settings → API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# Vercel 前端环境变量（需要在 Vercel Dashboard 里手动添加）
# 前端只需要这两个，不需要 API Key 和 SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# Agent 交互数据采集（内部应用默认采集）
NUTRIMASTER_INTERACTION_CAPTURE_ENABLED=true
NUTRIMASTER_INTERACTION_CAPTURE_REQUIRE_CONSENT=false
NUTRIMASTER_INTERACTION_PRIVACY_LEVEL=standard
# 默认写入 data/interactions，可替换为挂载盘路径
# NUTRIMASTER_INTERACTION_CAPTURE_DIR=/var/lib/nutrimaster/interactions
# 默认不保存个人库工具返回全文
NUTRIMASTER_INTERACTION_INCLUDE_PERSONAL_CONTENT=false


# 后台
ADMIN_EMAIL=3069867102@qq.com

# 163 邮箱 SMTP 配置
SMTP_USER=nutrimaster@163.com
SMTP_PASSWORD=your-smtp-password

# 网络
NUTRIMASTER_PROXY_URL=your-proxy-url
