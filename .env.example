# ═══════════════════════════════════════════════════════════
# NutriMaster Pipeline - 环境变量配置模板
# ═══════════════════════════════════════════════════════════
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# .env 文件已在 .gitignore 中，不会被上传到 GitHub
# ═══════════════════════════════════════════════════════════

# LLM API
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=http://43.159.131.233:3001/v1
MAIN_MODEL=deepseek-v4-flash
EXTRACTOR_MODEL=gpt-5.5

# ═══════════════════════════════════════════════════════════
# Supabase（Web 标注平台数据导入用）
# ═══════════════════════════════════════════════════════════
# 在 Supabase Dashboard → Settings → API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ═══════════════════════════════════════════════════════════
# Vercel 前端环境变量（需要在 Vercel Dashboard 里手动添加）
# ═══════════════════════════════════════════════════════════
# 前端只需要这两个，不需要 API Key 和 SERVICE_ROLE_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ═══════════════════════════════════════════════════════════
# Agent 交互数据采集（内部应用默认采集）
# ═══════════════════════════════════════════════════════════
NUTRIMASTER_INTERACTION_CAPTURE_ENABLED=true
NUTRIMASTER_INTERACTION_CAPTURE_REQUIRE_CONSENT=false
NUTRIMASTER_INTERACTION_PRIVACY_LEVEL=standard
# 默认写入 data/interactions，可替换为挂载盘路径
# NUTRIMASTER_INTERACTION_CAPTURE_DIR=/var/lib/nutrimaster/interactions
# 默认不保存个人库工具返回全文
NUTRIMASTER_INTERACTION_INCLUDE_PERSONAL_CONTENT=false

RAG_DATA_DIR=/root/Projects/NutriMaster/data/corpus
RAG_INDEX_DIR=/root/Projects/NutriMaster/data/index
RAG_PERSONAL_LIB_DIR=/root/Projects/NutriMaster/data/personal_lib
NUTRIMASTER_WEB_BUILD_INDEX=0
NUTRIMASTER_JINA_PROXY_ENABLED=false
NUTRIMASTER_JINA_PROXY_URL=http://127.0.0.1:7890
NUTRIMASTER_CLASH_START_SCRIPT=/root/clash/start-clash.sh
NUTRIMASTER_CLASH_STOP_SCRIPT=/root/clash/stop-clash.sh
NUTRIMASTER_JINA_PROXY_IDLE_STOP_SECONDS=300
NUTRIMASTER_DISABLE_BM25=true
NUTRIMASTER_RAG_MMAP_EMBEDDINGS=true
